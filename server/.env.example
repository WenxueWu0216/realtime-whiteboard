# Every variable is optional; with none set the server runs single-instance
# with in-memory storage (good for a quick look, nothing is persisted).

PORT=1234
# INSTANCE_ID=pod-a              # defaults to $HOSTNAME (the pod name on Kubernetes)

# --- horizontal scaling + op log hot tail ----------------------------------
REDIS_URL=redis://localhost:6379

# --- live-doc snapshots + recording index ----------------------------------
MONGO_URL=mongodb://localhost:27017
# MONGO_DB=whiteboard

# --- durable recording storage (S3 or any S3 API) ---------------------------
S3_BUCKET=whiteboard
AWS_REGION=us-east-1
# Local emulators only (leave all four unset on AWS; IRSA provides credentials):
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true       # default: true when S3_ENDPOINT is set
# S3_PRESIGN_TTL_SECONDS=300

# --- recording / replay tuning ---------------------------------------------
# RECORDING_ENABLED=true
# SNAPSHOT_EVERY_OPS=1000        # snapshot every N ops ...
# SNAPSHOT_EVERY_MS=60000        # ... or every T ms of session time
# SEGMENT_MAX_OPS=500            # flush the hot tail to S3 at N ops ...
# SEGMENT_MAX_AGE_MS=5000        # ... or when the oldest unflushed op is this old
# RECORDER_TICK_MS=500
# RECORDER_LEASE_MS=15000

# --- ops ---------------------------------------------------------------------
# CORS_ORIGIN=*
# SHUTDOWN_DRAIN_MS=5000         # time between failing /readyz and closing sockets
# EMPTY_ROOM_TTL_MS=30000
