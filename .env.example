# Copy to .env (git-ignored) and change the values:  cp .env.example .env
# docker compose reads .env automatically. Every value below is a FAKE
# placeholder for local development only - never reuse them anywhere real.

# Host port the app (UI + WebSocket) is published on: http://localhost:8080
APP_HOST_PORT=8080

# Host ports for Redis / Mongo (bound to 127.0.0.1 only), so `npm run dev`
# in server/ can use them too. Change if they clash with something local.
REDIS_HOST_PORT=6379
MONGO_HOST_PORT=27017

# MongoDB root user created on first start of the mongo container.
# Use URL-safe characters only (letters, digits, - _ .): they are embedded
# into the MONGO_URL connection string that compose builds for the app.
MONGO_ROOT_USERNAME=whiteboard_dev
MONGO_ROOT_PASSWORD=change-me-local-only
